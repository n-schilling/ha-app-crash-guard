#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# The web page behind Home Assistant's ingress. It runs as user cgweb, without
# root and without the Supervisor token, so a flaw in it reaches neither the
# Docker socket nor the Supervisor. It reads the guard's data through the
# group cgweb and writes only to its own folder, the page's requests.
# ==============================================================================
readonly PRIV=/data/crash_guard
readonly USER_NAME=cgweb

# The data is root's; the folders pass the group cgweb on to what the guard
# writes (setgid), and the guard's umask 027 keeps everyone else out. Up to
# 2.2.0 everything was readable for all, and the page wrote its requests to
# the data folder itself.
mkdir -p "${PRIV}"
chgrp -hR "${USER_NAME}" "${PRIV}"
find "${PRIV}" -type d -exec chmod 2750 {} +
find "${PRIV}" -type f -exec chmod g+r,g-wx,o-rwx {} +
install -d -o "${USER_NAME}" -g "${USER_NAME}" -m 0750 "${PRIV}/web"
rm -f "${PRIV}/check.request" "${PRIV}/check.requested"

bashio::log.info 'Starting the web page'
exec env -u SUPERVISOR_TOKEN s6-setuidgid "${USER_NAME}" python3 /usr/local/lib/crash_guard_web.py
